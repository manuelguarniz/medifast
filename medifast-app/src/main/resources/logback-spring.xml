<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback: consola + archivo rotativo + auditoría (README §11.3, RNF07: sin contraseñas ni documentos completos) -->
<configuration>
    <!-- RNF07: %m / %msg / %message enmascaran documentos, celulares y correos en todos los appenders.
         Van antes de los include para que también apliquen al patrón de consola de Spring Boot. -->
    <conversionRule conversionWord="m" class="pe.edu.utp.medifast.util.logging.MensajeEnmascaradoConverter"/>
    <conversionRule conversionWord="msg" class="pe.edu.utp.medifast.util.logging.MensajeEnmascaradoConverter"/>
    <conversionRule conversionWord="message" class="pe.edu.utp.medifast.util.logging.MensajeEnmascaradoConverter"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/medifast.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/medifast.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Eventos de auditoría (util/Auditoria): login, logout, reserva, validación, rechazo, cancelación -->
    <appender name="AUDITORIA" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/auditoria.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="AUDITORIA" level="INFO" additivity="false">
        <appender-ref ref="AUDITORIA"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- DEBUG solo fuera de producción; en producción se activa el perfil prod (SPRING_PROFILES_ACTIVE=prod) -->
    <springProfile name="!prod">
        <logger name="pe.edu.utp.medifast" level="DEBUG"/>
    </springProfile>
    <springProfile name="prod">
        <logger name="pe.edu.utp.medifast" level="INFO"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
